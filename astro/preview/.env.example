# Copy to .env next to compose.yaml and fill in.

# Required: an api_users key for /api/db_dump.php.
SE_KEY=

# Image tag: latest (main), or pr-<number> to test a PR.
PREVIEW_TAG=latest

# Port on the host.
PREVIEW_PORT=8080

# Optional overrides.
# SE_BASE=https://www.scriptureearth.org
# SE_SITE_URL=https://se-proto-en.pages.dev
