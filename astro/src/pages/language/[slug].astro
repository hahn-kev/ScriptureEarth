---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ResourceRow from '../../components/ResourceRow.astro';
import LangCard from '../../components/LangCard.astro';
import { GROUPS } from '../../lib/ui';

export async function getStaticPaths() {
  const langs = await getCollection('languages');
  // "Similar languages": entries sharing this ISO code (dialects, scripts, editions of one
  // language). ISO 639-3 private-use codes (qaa–qtz) are placeholders — `qqq` holds 18
  // unrelated sign languages — so they never group.
  const byIso: Record<string, any[]> = {};
  for (const l of langs) {
    const iso = String(l.data.identity.iso).toLowerCase();
    if (!/^q[a-t][a-z]$/.test(iso)) (byIso[iso] ??= []).push(l.data);
  }
  for (const list of Object.values(byIso)) list.sort((a, b) => a.identity.slug.localeCompare(b.identity.slug));
  return langs.map((l) => ({
    params: { slug: l.data.identity.slug },
    props: {
      d: l.data,
      versions: (byIso[String(l.data.identity.iso).toLowerCase()] || []).filter((v) => v.idx !== l.data.idx),
    },
  }));
}

const { d, versions } = Astro.props;
const name = d.names.localized.eng;
const activeGroups = GROUPS.filter((g) => (d.resources[g.key] || []).length > 0);
// idx is the legacy site's unique key (iso alone can match several entries).
const legacyUrl = `https://www.scriptureearth.org/00eng.php?idx=${d.idx}`;
---
<Base title={`${name} — ScriptureEarth`}>
  <section class="block shell">
    <nav class="crumbs"><a href="/"><span class="ic ic-home" aria-hidden="true"></span><span data-i18n="crumb.home">Home</span></a><span>›</span><a href="/browse/" data-i18n="nav.languages">Languages</a><span>›</span><span>{name}</span></nav>
    <div class="with-side">
      <div>
        <div class="rec-head"><h1 data-i18n-name={String(d.idx)}>{name}</h1>{d.identity.variant_name && <span class="muted">{d.identity.variant_name}</span>}</div>
        <div class="rec-meta">
          <span class="chip"><span data-i18n="meta.iso">ISO</span> <a class="iso-link" href={`https://www.ethnologue.com/language/${d.identity.iso}/`} target="_blank" rel="noopener noreferrer" title="Ethnologue"><code>{d.identity.iso}</code></a></span>
          {d.countries.length > 0 && <span class="chip">{d.countries.map((c: any, i: number) => (<>{i > 0 && ' · '}<span data-i18n-country={c.code}>{c.name_eng}</span></>))}</span>}
        </div>
        {d.names.alt_names.length > 0 && <p class="alt-names"><span data-i18n="meta.also">Also:</span> {d.names.alt_names.join(', ')}</p>}

        {activeGroups.length === 0 && <p class="muted" data-i18n="detail.noresources">No resources catalogued yet for this language.</p>}
        {activeGroups.map((g) => (
          <div class="res-group" id={g.key}>
            <div class="rg-head"><span class={`ic ic-${g.key}`} data-r={g.key} aria-hidden="true"></span><h3 data-i18n={`group.${g.key}`}>{g.label}</h3><span class="n">{d.resources[g.key].length}</span></div>
            {d.resources[g.key].map((r: any) => <ResourceRow group={g.key} r={r} />)}
          </div>
        ))}

        {versions.length > 0 && (
          <div class="similar" id="similar">
            <h2 data-i18n="detail.similarLanguages">Similar languages</h2>
            <div class="lang-grid">{versions.map((v: any) => <LangCard d={v} />)}</div>
          </div>
        )}
      </div>

      <aside class="side">
        <h4 data-i18n="detail.onthispage">On this page</h4>
        <div class="toc">
          {activeGroups.map((g) => (<a href={`#${g.key}`}><span class={`ic ic-${g.key}`} data-r={g.key} aria-hidden="true"></span><span data-i18n={`group.${g.key}`}>{g.label}</span><span class="c tnum">{d.resources[g.key].length}</span></a>))}
          {versions.length > 0 && <a href="#similar"><span class="ic ic-locale" aria-hidden="true"></span><span data-i18n="detail.similarLanguages">Similar languages</span><span class="c tnum">{versions.length}</span></a>}
        </div>
        {d.countries.length > 0 && (
          <>
            <h4 data-i18n="nav.countries">Countries</h4>
            <div class="toc">
              {d.countries.map((c: any) => (<a href={`/country/${c.code}/`}><span data-i18n-country={c.code}>{c.name_eng}</span><span class="c">{c.code}</span></a>))}
            </div>
          </>
        )}
        <h4 data-i18n="detail.original">Original site</h4>
        <div class="toc">
          <a href={legacyUrl} target="_blank" rel="noopener noreferrer"><span class="ic ic-open" aria-hidden="true"></span><span data-i18n="detail.viewlegacy">View on ScriptureEarth.org</span></a>
        </div>
      </aside>
    </div>
  </section>
</Base>
