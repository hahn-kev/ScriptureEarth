---
// Cloudflare Pages serves /404.html for any unmatched path (after _redirects).
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — ScriptureEarth">
  <section class="block shell">
    <nav class="crumbs"><a href="/" data-i18n="crumb.home">Home</a><span>›</span><span>404</span></nav>
    <div class="sec-head">
      <div><p class="eyebrow">404</p><h2>Page not found</h2></div>
    </div>
    <p>
      Try the <a href="/">search</a> on the home page, or <a href="/browse/">browse all languages</a>
      and <a href="/countries/">countries</a>.
    </p>
  </section>
</Base>
