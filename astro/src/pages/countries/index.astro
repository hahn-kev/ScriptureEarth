---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import geo from '../../data/geo.json';

const countries = (await getCollection('countries')).map((c) => c.data)
  .filter((c) => c.languages.length > 0)
  .sort((a, b) => a.name.eng.localeCompare(b.name.eng));
const totalLangs = countries.reduce((n, c) => n + c.languages.length, 0);

// Group alphabetical-within-continent; continents in geo.order, unknowns last.
const regionsInUse = geo.order.filter((r) => countries.some((c) => geo.regions[c.code] === r));
const groups = regionsInUse.map((region) => ({
  region,
  list: countries.filter((c) => geo.regions[c.code] === region),
}));
const ungrouped = countries.filter((c) => !geo.order.includes(geo.regions[c.code]));
if (ungrouped.length) groups.push({ region: 'Other', list: ungrouped });
---
<Base title="Countries — ScriptureEarth">
  <section class="block shell">
    <nav class="crumbs"><a href="/" data-i18n="crumb.home">Home</a><span>›</span><span data-i18n="nav.countries">Countries</span></nav>
    <div class="sec-head">
      <div><p class="eyebrow" data-i18n="browse.eyebrow">Browse</p><h2 data-i18n="nav.countries">Countries</h2></div>
      <span class="facet-count"><span class="tnum">{countries.length}</span> <span data-i18n="unit.countries">countries</span> · <span class="tnum">{totalLangs.toLocaleString()}</span> <span data-i18n="unit.entries">entries</span></span>
    </div>

    <div id="geo-suggest" class="geo-suggest" hidden></div>

    {groups.map(({ region, list }) => (
      <div class="reg-group">
        <h3 class="reg-h" data-i18n={`region.${region}`}>{region}</h3>
        <div class="facets">
          {list.map((c) => (
            <a class="facet" href={`/country/${c.code}/`} data-code={c.code} data-name={c.name.eng}>{c.name.eng} <span class="x tnum">{c.languages.length}</span></a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <script>import '../../scripts/geo-suggest.js';</script>
</Base>
