---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const countries = await getCollection('countries');
  return countries.map((c) => ({ params: { code: c.data.code }, props: { d: c.data } }));
}
const { d } = Astro.props;
---
<Base title={`${d.name.eng} — ScriptureEarth`}>
  <section class="block shell">
    <nav class="crumbs"><a href="/" data-i18n="crumb.home">Home</a><span>›</span><a href="/countries/" data-i18n="nav.countries">Countries</a><span>›</span><span>{d.name.eng}</span></nav>
    <div class="sec-head"><div><p class="eyebrow" data-i18n="country.eyebrow">Country</p><h2>{d.name.eng}</h2></div><span class="facet-count"><span class="tnum">{d.languages.length}</span> <span data-i18n="unit.languages">language(s)</span></span></div>
    <div class="lang-grid">
      {d.languages.map((l: any) => (
        <a class="lang" href={`/language/${l.slug}/`}>
          <div class="top"><span class="code">{l.iso}</span><span class="nm" data-i18n-name={String(l.idx)}>{l.name_eng}</span></div>
          {l.variant_name && <div class="auto">{l.variant_name}</div>}
          {l.alt_names.length > 0 && <div class="where"><span data-i18n="meta.also">Also:</span> {l.alt_names.join(', ')}</div>}
        </a>
      ))}
    </div>
  </section>
</Base>
