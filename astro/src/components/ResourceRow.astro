---
import { actionLabel, actionSlug } from '../lib/ui';

interface Props { group: string; r: any; }
const { group, r } = Astro.props;
const clips = ['watch', 'listen'].includes(group) && Array.isArray(r.meta?.clips) && r.meta.clips.length > 1 ? r.meta.clips : null;
const blank = group === 'watch' || r.external;
const isAudio = group === 'listen';
const clipWord = isAudio ? 'tracks' : 'clips';
const clipFmt = isAudio ? 'Track' : 'Clip';
const clipAction = isAudio ? 'Play' : 'Watch';
---
<div class="res-row">
  <span class="fmt">{r.format}</span>
  <div>
    <div class="rr-name">{r.name}</div>
    {r.source && <div class="rr-src">{r.source}</div>}
  </div>
  {r.url
    ? <a class="act" href={r.url} rel="noopener noreferrer" target={blank ? '_blank' : undefined}><span data-i18n={actionSlug(group, r.kind)}>{actionLabel(group, r.kind)}</span> →</a>
    : <span class="act muted">—</span>}
</div>
{clips && (
  <details class="res-clips">
    <summary>{clips.length} {clipWord}</summary>
    {clips.map((c: any) => (
      <div class="res-row">
        {c.image
          ? <img class="clip-thumb" src={c.image} alt="" loading="lazy" width="64" height="36" />
          : <span class="fmt">{clipFmt}</span>}
        <div><div class="rr-name">{c.title}</div></div>
        <a class="act" href={c.url} target="_blank" rel="noopener noreferrer">{clipAction} →</a>
      </div>
    ))}
  </details>
)}
