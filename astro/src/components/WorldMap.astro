---
// Home-page world map: countries shaded by how many languages have Scripture.
// The SVG is generated by scripts/gen_map.mjs (part of `extract`) into content/ and
// imported with ?url so it ships as a content-hashed /_astro/ file (cached immutably).
// src/scripts/world-map.js fetches it only when the section nears the viewport, so a
// visitor who only searches never downloads it. It never loads the language list or
// the search index. Legend edges must match BUCKETS in scripts/gen_map.mjs.
import mapUrl from '../../content/world-map.svg?url';
// PROTOTYPE: every projection gen_map renders, for the team to compare (switch in the test
// panel or ?proj=<id>). The manifest gives each map's label and viewBox size, so the box
// reserved for the map takes its real shape and nothing jumps when it loads.
import projections from '../../content/world-map-projections.json';
const urls = import.meta.glob('../../content/world-map*.svg', { query: '?url', import: 'default', eager: true }) as Record<string, string>;
const maps = Object.fromEntries(projections.map((p: any) => [p.id, { label: p.label, url: urls[`../../content/${p.file}`], aspect: `${p.w} / ${p.h}` }]));
const aspect = maps.mercator.aspect;
---
<section class="block shell world-map" id="world-map" aria-labelledby="wm-heading">
  <div class="wm-head">
    <p class="eyebrow" id="wm-heading" data-i18n="map.heading">Languages with Scripture, by country</p>
    <a class="wm-all" href="/countries/"><span data-i18n="map.allCountries">All countries</span> →</a>
  </div>
  <div class="wm-grid" id="wm-grid">
    <div class="wm-col">
      <div class="wm-mapbox">
        <div class="wm-map" id="wm-map" data-map-url={mapUrl} data-maps={JSON.stringify(maps)} style={`aspect-ratio: ${aspect}`} role="img" aria-label="World map: languages with Scripture by country" data-i18n-label="map.label"></div>
        <button type="button" class="wm-zoomout" id="wm-zoomout" aria-label="Whole world" data-i18n-label="map.zoomOut" hidden>−</button>
      </div>
      <div class="wm-legend">
        <span data-i18n="map.legend">Languages per country</span>
        <span><i class="b1"></i>1–4</span><span><i class="b2"></i>5–19</span><span><i class="b3"></i>20–79</span><span><i class="b4"></i>80+</span>
      </div>
      <!-- PROTOTYPE controls: zoom factor, duration, projection, for testing on a phone. Remove before merge. -->
      <form class="wm-proto" id="wm-proto" onsubmit="return false">
        <label>zoom <input name="zoom" type="range" min="1.5" max="5" step="0.25" value="3" /> <b data-out="zoom">3</b>×</label>
        <label>ms <input name="ms" type="range" min="0" max="700" step="20" value="260" /> <b data-out="ms">260</b></label>
        <label>projection <select name="proj">{projections.map((p: any) => <option value={p.id}>{p.label}</option>)}</select></label>
      </form>
    </div>
    <div class="wm-list" id="wm-list" hidden>
      <div class="wm-list-head">
        <span data-i18n="map.listTitle">Countries near here</span>
        <button type="button" id="wm-close" aria-label="Dismiss" data-i18n-label="geo.dismiss">×</button>
      </div>
      <ul id="wm-ul"></ul>
    </div>
  </div>
  <div class="wm-tip" id="wm-tip" hidden></div>
</section>
<style is:global>
  /* is:global: the SVG is injected at runtime, so scoped styles would not reach it.
     Lives here (not site.css) so only the home page downloads it. */
  /* World map (home) — src/components/WorldMap.astro + src/scripts/world-map.js.
     Bucket colours = languages with Scripture per country (edges in scripts/gen_map.mjs). */
  .world-map {
    --map-0: var(--border);
    --map-1: #bfdcf3;
    --map-2: #7fb6e4;
    --map-3: #2f7fc4;
    --map-4: #003f7f;
    --map-hi: var(--sil-orange);
    --wm-hdr: 64px;
  }
  .wm-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s3);
    flex-wrap: wrap;
    margin-block-end: var(--s3);
  }
  .wm-all {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .wm-grid {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }
  .wm-map {
    aspect-ratio: 1000 / 650;
    width: 100%;
    background: var(--surface-2);
    border-radius: var(--radius);
    overflow: hidden;
    touch-action: manipulation;
    /* Chrome draws its tap highlight around a shape's bounding box (Russia = the whole map);
       tapped countries already turn orange, so hide it. */
    -webkit-tap-highlight-color: transparent;
  }
  .wm-map svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .wm-mapbox {
    position: relative;
  }
  .wm-zoomout {
    position: absolute;
    inset-block-start: 8px;
    inset-inline-end: 8px;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--heading);
    font-size: 1.5rem;
    line-height: 1;
    box-shadow: var(--shadow-sm);
    cursor: pointer;
  }
  .wm-proto {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-block-start: var(--s2);
    padding: 6px 8px;
    border: 1px dashed var(--sil-orange);
    border-radius: 8px;
    font: 12px ui-monospace, monospace;
    color: var(--muted);
  }
  .wm-proto input[type="range"] {
    width: 90px;
    vertical-align: middle;
  }
  .wm-map path,
  .wm-map circle {
    fill: var(--map-0);
    stroke: var(--surface);
    stroke-width: 0.6;
    vector-effect: non-scaling-stroke;
    transition: fill 0.12s;
  }
  .wm-map circle {
    stroke-width: 1;
  }
  .wm-map .b1, .wm-legend .b1 { fill: var(--map-1); background: var(--map-1); }
  .wm-map .b2, .wm-legend .b2 { fill: var(--map-2); background: var(--map-2); }
  .wm-map .b3, .wm-legend .b3 { fill: var(--map-3); background: var(--map-3); }
  .wm-map .b4, .wm-legend .b4 { fill: var(--map-4); background: var(--map-4); }
  .wm-map [data-n]:not([data-n="0"]) {
    cursor: pointer;
  }
  @media (hover: hover) {
    .wm-map [data-n]:not([data-n="0"]):hover {
      fill: var(--map-hi);
    }
  }
  .wm-map .is-near {
    fill: var(--map-hi);
  }
  .wm-map .is-you {
    stroke: var(--map-hi);
    stroke-width: 2;
  }
  .wm-legend {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-start: var(--s2);
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .wm-legend i {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    margin-inline-end: 3px;
    vertical-align: -1px;
  }
  .wm-list {
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .wm-list-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex: none;
    padding-block: var(--s2);
    padding-inline: var(--s3) var(--s2);
    font-size: 0.8rem;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .wm-list-head button {
    width: 32px;
    height: 32px;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }
  .wm-list ul {
    flex: 1 1 auto;
    min-height: 0;
    margin: 0;
    padding: var(--s1) 0;
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .wm-list li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s3);
    min-height: 44px;
    padding: var(--s2) var(--s3);
    color: var(--text);
  }
  .wm-list li a:hover,
  .wm-list li a:focus-visible {
    background: var(--tint);
  }
  .wm-list li.you a {
    font-weight: 600;
  }
  .wm-list .n {
    color: var(--muted);
  }
  .wm-tip {
    position: fixed;
    z-index: 30;
    pointer-events: none;
    transform: translate(-50%, -140%);
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--heading);
    color: #fff;
    font-size: 0.82rem;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    /* Phones: the map runs edge to edge (cancel the .shell side padding). */
    .wm-mapbox {
      margin-inline: calc(-1 * var(--s5));
    }
    .wm-map {
      border-radius: 0;
    }
    .wm-legend {
      gap: 0.45rem;
    }
  }
  @media (max-width: 360px) {
    .wm-legend {
      gap: 0.3rem;
      font-size: 0.68rem;
    }
    .wm-legend i {
      margin-inline-end: 2px;
    }
  }
  @media (max-width: 899px) {
    /* After a tap, map + list fill the screen below the sticky header; the list scrolls.
       When the map alone is nearly a screen tall (landscape phone), keep at least 12rem
       of list under it and let the page scroll instead of squeezing the list to nothing. */
    .world-map.is-open .wm-grid {
      height: max(calc(100dvh - var(--wm-hdr) - 8px), calc(var(--wm-col-h, 0px) + var(--s2) + 12rem));
    }
    .world-map.is-open.is-pinched .wm-grid {
      /* pinch-zoomed: no screen-filling; the list sits under the map at a fixed height */
      height: auto;
    }
    .world-map.is-pinched .wm-list ul {
      max-height: 18rem;
    }
    .world-map.is-open .wm-col {
      flex: none;
    }
    .world-map.is-open .wm-list {
      flex: 1 1 auto;
    }
  }
  @media (min-width: 900px) {
    /* Wide screens: the list sits beside the map, at the map's height. */
    .wm-grid {
      flex-direction: row;
      align-items: stretch;
    }
    .wm-col {
      flex: 1 1 auto;
      min-width: 0;
    }
    .wm-list {
      flex: 0 0 280px;
    }
  }
</style>

<noscript><style>#world-map { display: none; }</style></noscript>

<script>import '../scripts/world-map.js';</script>
